{"id":"DEC-001","type":"assumption","decision":"No user authentication by default","reason":"The raw request does not require accounts or private user areas","impact":"Avoids unnecessary storage of personal data and reduces implementation scope","reversible":true,"verification":"Blueprint and capability boundaries must not require auth unless future requirements add it","source":"sdc compile","created_at":"1970-01-01T00:00:00Z"}
